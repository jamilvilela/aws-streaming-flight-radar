        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:logs:us-east-1:331504768406:log-group:/aws/kinesisanalytics/flight-radar-stream-kda-flights:log-stream:FlinkApplicationLogs",
            "id": "FlinkApplicationLogs",
            "log_group_name": "/aws/kinesisanalytics/flight-radar-stream-kda-flights",
            "name": "FlinkApplicationLogs",
            "region": "us-east-1"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
          "dependencies": [
            "data.aws_caller_identity.current",
            "data.aws_s3_bucket.landing",
            "module.iam.aws_iam_role.firehose_role",
            "module.iam.aws_iam_role.kda_execution",
            "module.iam.aws_iam_role.lambda_execution",
            "module.iam.aws_iam_role_policy.firehose_policy",
