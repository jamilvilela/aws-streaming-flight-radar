            "dashboard_body": "{\"widgets\":[{\"height\":1,\"properties\":{\"markdown\":\"# 🚀 FLIGHT-RADAR-STREAM - Pipeline\\n**Ambiente:** PRODUCTION\"},\"type\":\"text\",\"width\":24,\"x\":0,\"y\":0},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[]},\"metrics\":[[\"AWS/Kinesis\",\"IncomingRecords\",\"StreamName\",\"flight-radar-stream-flights\",{\"color\":\"#1f77b4\",\"label\":\"Count\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"📥 Registros Entrando\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"label\":\"Reg/min\",\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":1},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#d62728\",\"label\":\"Threshold\",\"value\":60000}]},\"metrics\":[[\"AWS/Kinesis\",\"GetRecords.IteratorAgeMilliseconds\",\"StreamName\",\"flight-radar-stream-flights\",{\"color\":\"#d62728\",\"label\":\"ms\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Maximum\",\"title\":\"⏱️ Iterator Age\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"label\":\"ms\",\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":1},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[]},\"metrics\":[[\"AWS/Kinesis\",\"IncomingBytes\",\"StreamName\",\"flight-radar-stream-flights\",{\"color\":\"#1f77b4\",\"label\":\"In\"}],[\"AWS/Kinesis\",\"OutgoingBytes\",\"StreamName\",\"flight-radar-stream-flights\",{\"color\":\"#2ca02c\",\"label\":\"Out\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"📊 Throughput\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"label\":\"Bytes\",\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":7},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[]},\"metrics\":[[\"AWS/Kinesis\",\"WriteProvisionedThroughputExceeded\",\"StreamName\",\"flight-radar-stream-flights\",{\"color\":\"#d62728\",\"label\":\"Write\"}],[\"AWS/Kinesis\",\"ReadProvisionedThroughputExceeded\",\"StreamName\",\"flight-radar-stream-flights\",{\"color\":\"#ff7f0e\",\"label\":\"Read\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"⚠️ Throttling\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"label\":\"Count\",\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":7},{\"height\":1,\"properties\":{\"markdown\":\"## 🪣 Firehose → S3\"},\"type\":\"text\",\"width\":24,\"x\":0,\"y\":13},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[]},\"metrics\":[[\"AWS/Firehose\",\"DeliveryToS3.Success\",\"DeliveryStreamName\",\"flight-radar-firehose-flights\",{\"color\":\"#2ca02c\",\"label\":\"OK\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"✅ Sucesso\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":8,\"x\":0,\"y\":14},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[]},\"metrics\":[[\"AWS/Firehose\",\"DeliveryToS3.Failed\",\"DeliveryStreamName\",\"flight-radar-firehose-flights\",{\"color\":\"#d62728\",\"label\":\"Fail\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"❌ Falhas\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":8,\"x\":8,\"y\":14},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[]},\"metrics\":[[\"AWS/Firehose\",\"DeliveryToS3.Success\",\"DeliveryStreamName\",\"flight-radar-firehose-flights\",{\"color\":\"#1f77b4\",\"label\":\"%\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"📈 Taxa %\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"label\":\"%\",\"max\":100,\"min\":0}}},\"type\":\"metric\",\"width\":8,\"x\":16,\"y\":14}]}",
