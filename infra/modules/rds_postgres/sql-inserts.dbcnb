cells:
  - kind: 2
    languageId: sql
    value: select * from aircraft;
    metadata: {}
  - kind: 2
    languageId: sql
    value: "\r

      SELECT ap.position_id, ap.aircraft_icao24, f.flight_number, ap.latitude,
      ap.longitude, ap.altitude_ft, ap.velocity_kts, ap.heading, ap.on_ground,
      ap.recorded_at\r

      FROM aircraft_positions ap\r

      LEFT JOIN flights f ON ap.flight_id = f.flight_id\r

      ORDER BY ap.recorded_at;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: |
      -- Verify: count positions per aircraft and show sample data
      SELECT a.icao24, a.registration, COUNT(ap.position_id) AS num_positions
      FROM aircraft a
      LEFT JOIN aircraft_positions ap ON a.icao24 = ap.aircraft_icao24
      GROUP BY a.icao24, a.registration
      ORDER BY a.icao24;
    metadata: {}
  - kind: 2
    languageId: sql
    value: "\r

      INSERT INTO airlines (icao_code, iata_code, name, country, callsign)
      VALUES\r

      \    ('YYY', 'AA', 'American Airlines', 'United States', 'AMERICAN')\r

      ON CONFLICT (icao_code) DO NOTHING;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: ""
    metadata: {}
