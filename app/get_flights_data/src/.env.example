# Kinesis stream name kept for backward compatibility with local tooling.
# The notebook no longer writes to Kinesis directly; it POSTs to the
# project's edge API Gateway, which forwards validated records to Kinesis.
KINESIS_STREAM='flight-radar-stream-flights'

# Logging
LOG_LEVEL='INFO'

# OpenSky OAuth2 credentials (used to call /api/states/all)
OPENSKY_CLIENT_ID='your_opensky_client_id'
OPENSKY_CLIENT_SECRET='your_opensky_client_secret'

# Project edge API (output of `terraform apply`).
# `terraform output -raw api_invoke_url` produces the base URL.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/v1
API_BASE_URL='https://your-api-id.execute-api.us-east-1.amazonaws.com/v1'

# `terraform output -raw api_key_value` (sensitive).
API_KEY='your_api_key'

# Optional origin tag attached to every batch payload
SOURCE_TAG='notebook-get-flights-data'

# Per-call safety caps
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
BATCH_CHUNK_SIZE=500
